# Bookstore Inventory API - environment template.
# NOTE: the harness that generated this repository forbids writing files whose
# name starts with ".env", so this template is shipped as "env.example".
# Copy it to a local configuration file before running the project:
#   cp env.example .env        (or set the same variables in your shell)
# Never commit the real configuration file; ".env" is already git-ignored.

# --- Django ------------------------------------------------------------------
SECRET_KEY=dev-insecure-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Database ----------------------------------------------------------------
# Unset -> SQLite file "db.sqlite3" next to manage.py (local development).
# DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://bookstore:bookstore@localhost:5432/bookstore

# --- API ---------------------------------------------------------------------
PAGE_SIZE=10

# --- Business rules ----------------------------------------------------------
LOCAL_CURRENCY=EUR
PROFIT_MARGIN_PERCENTAGE=40
LOW_STOCK_THRESHOLD=10

# --- Exchange-rate integration ----------------------------------------------
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD
FALLBACK_EXCHANGE_RATE=0.85
EXCHANGE_FALLBACK_ENABLED=true
EXCHANGE_RATE_TIMEOUT=5

# --- CORS --------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200
